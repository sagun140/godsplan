{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godsplan",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/_data/*"]
  },
  "d1_databases": [
    // database_id comes from `npx wrangler d1 create godsplan`
    { "binding": "DB", "database_name": "godsplan", "database_id": "REPLACE_WITH_D1_ID" }
  ],
  "vars": {
    // Wallet that receives USDC on Base: agent API calls, paid review requests and tips.
    "PAY_TO": "0x3DB77A6B6BdD050279068c70E358fF766070fb99",
    // eip155:8453 = Base mainnet (real USDC). Use eip155:84532 (Base Sepolia) to test.
    "NETWORK": "eip155:8453",
    "FACILITATOR_URL": "https://facilitator.payai.network",
    "BASE_RPC_URL": "https://mainnet.base.org",
    "REVIEW_PRICE_USDC": "20",
    // GitHub logins allowed to verify or remove community submissions, comma-separated.
    "ADMINS": "sagun140"
  }
  // Secrets (wrangler secret put): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SESSION_SECRET
}
